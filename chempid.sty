                \pgfpatharc{180}{540}{\pgf@xa}
                \pgfpathclose                
            }
        }},
        /crusher/cone/.code = {
            \pgfkeys{/crusher/basic/.append code = {
                \pgfpointscale{0.3}{\southeast}
                \pgf@xa = \pgf@x

                \pgfpointscale{0.5}{\southeast}
                \pgf@ya = \pgf@y

                \pgfpointscale{0.6}{\southeast}
                \pgf@xb = \pgf@x

