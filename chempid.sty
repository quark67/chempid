                \pgfpathlineto{\pgfpoint{1.3\pgf@xa}{\pgf@ya}}
                \pgfpathlineto{\pgfpoint{1.3\pgf@xa}{0.6\pgf@ya}}

                \pgfpathmoveto{\pgfpoint{-1.3\pgf@xa}{-0.6\pgf@ya}}
