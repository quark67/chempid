                    \pgfpointscale{\j}{\pgfpoint{\pgf@xa}{0}}
                    \pgfpathmoveto{\pgfpoint{\pgf@x}{-2 \pgf@ya}}

                    \pgfpointscale{\j + 6}{\pgfpoint{\pgf@xa}{0}}
                    \pgfpathlineto{\pgfpoint{\pgf@x}{0}}
                }

                \pgfusepath{stroke}
            }
        }},
