        \pgfpoint{\pgf@xa + \pgf@x}{\pgf@ya + \pgf@y}
        \pgf@xb = \pgf@x
        \pgf@yb = \pgf@y

        
        \pgfpathmoveto{\pgfpoint{\pgf@xa}{\pgf@ya}}
        \pgfpathlineto{\pgfpoint{\pgf@xb}{\pgf@yb}}
        
        \pgfpathmoveto{\pgfpoint{-\pgf@xa}{\pgf@ya}}
        \pgfpathlineto{\pgfpoint{-\pgf@xb}{\pgf@yb}}
        
        \pgfusepath{stroke}
        
        \pgfkeys{/mill/basic}
    
        \pgfusepath{stroke}
    }
