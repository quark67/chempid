        \pgfpathlineto{\pgfpoint{0}{-\pgf@ya}}

        \pgfpathmoveto{\pgfpoint{\pgf@xa}{-\pgf@yb}}   % Right part of V. Makes symmetrical dash
        \pgfpathlineto{\pgfpoint{0}{-\pgf@ya}}

        \pgfusepath{stroke}
        \pgfsetdash{}{0pt}

        \pgfkeys{/gas filter/basic}
    
        \pgfusepath{stroke}
    }
