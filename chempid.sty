                \pgfpathlineto{\pgfpointorigin}

                \pgfpointscale{0.3}{\southeast}
                \pgf@xa = \pgf@x

                \pgfpatharc{180}{540}{\pgf@xa}
                \pgfpathclose                
            }
        }},
        /crusher/roller/.code = {
